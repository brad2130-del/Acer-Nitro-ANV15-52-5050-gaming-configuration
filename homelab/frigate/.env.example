# Copy to .env and fill in. Frigate only substitutes variables prefixed FRIGATE_.
# .env is git-ignored — never commit real camera passwords.

# Cam 1: the Pi 3 + Camera Module v2 running MediaMTX (see pi3-cam/)
FRIGATE_CAM1_URL=rtsp://pi3.local:8554/cam

# Cams 2-4: main (record) and sub (detect) streams. If a camera has no substream,
# set both to the same URL.
FRIGATE_CAM2_MAIN=rtsp://user:pass@192.168.1.102:554/stream1
FRIGATE_CAM2_SUB=rtsp://user:pass@192.168.1.102:554/stream2
FRIGATE_CAM3_MAIN=rtsp://user:pass@192.168.1.103:554/stream1
FRIGATE_CAM3_SUB=rtsp://user:pass@192.168.1.103:554/stream2
FRIGATE_CAM4_MAIN=rtsp://user:pass@192.168.1.104:554/stream1
FRIGATE_CAM4_SUB=rtsp://user:pass@192.168.1.104:554/stream2

# Pixel detection endpoint (DeepStack-compatible). Use stub-detector/ until the app serves it.
FRIGATE_DETECTOR_URL=http://pixel8.lan:8080/v1/vision/detection

# Recordings location on the host (SSD strongly recommended)
FRIGATE_MEDIA_DIR=./media
